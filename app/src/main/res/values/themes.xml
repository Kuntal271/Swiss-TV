<resources>
    <style name="Theme.Swiss" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
    </style>
    <color name="ground">#0A0A0B</color>
    <color name="focus">#F2C230</color>
    <color name="ink">#EDEDED</color>
</resources>
